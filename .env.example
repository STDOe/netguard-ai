# Generate different values with: python3.12 -c 'import secrets; print(secrets.token_urlsafe(32))'
NETGUARD_VIEWER_TOKEN=
NETGUARD_ADMIN_TOKEN=
NETGUARD_DEMO_MODE=true

# Optional. Omit model and base for the offline planner.
# NETGUARD_LLM_MODEL=openai/your-model
# NETGUARD_LLM_API_BASE=https://your-provider.example/v1
# NETGUARD_LLM_API_KEY=
# NETGUARD_WORKFLOW_APPROVAL_TTL_SECONDS=300

# HTTPS deployments should force Secure session cookies behind a trusted TLS proxy.
NETGUARD_WEB_SECURE_COOKIES=false
# Optional. Generate a separate token_urlsafe(32) to enable signed honeypot events.
NETGUARD_HONEYPOT_SECRET=

# Workforce Integration is optional. Store only the digest on the server.
NETGUARD_INTEGRATION_ENABLED=false
NETGUARD_INTEGRATION_CALLER=workforce
NETGUARD_INTEGRATION_WORKSPACE=lab
NETGUARD_INTEGRATION_TOKEN_SHA256=
NETGUARD_INTEGRATION_EXPIRES_AT=
NETGUARD_INTEGRATION_SCOPES=[]
