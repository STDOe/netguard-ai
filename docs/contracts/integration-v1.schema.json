{
  "$defs": {
    "ApprovalView": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "format": "uuid",
          "title": "Approval Id",
          "type": "string"
        },
        "base_revision": {
          "title": "Base Revision",
          "type": "integer"
        },
        "expected_config_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Config Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "network_id": {
          "format": "uuid",
          "title": "Network Id",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "risk": {
          "enum": [
            "moderate",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "approve",
            "reject",
            "expired",
            "cancelled",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "plan_hash",
        "risk",
        "network_id",
        "expires_at",
        "policy_version",
        "base_revision",
        "expected_config_sha256",
        "approval_id",
        "workspace_id",
        "status"
      ],
      "title": "ApprovalView",
      "type": "object"
    },
    "ArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "href": {
          "title": "Href",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "const": "netguard.greenfield",
          "default": "netguard.greenfield",
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "href",
        "name",
        "media_type",
        "sha256",
        "size_bytes",
        "workspace_id",
        "task_id",
        "content"
      ],
      "title": "ArtifactContent",
      "type": "object"
    },
    "ArtifactLink": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "href": {
          "title": "Href",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "const": "netguard.greenfield",
          "default": "netguard.greenfield",
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "href",
        "name",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactLink",
      "type": "object"
    },
    "AuditRequest": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "const": "audit",
          "title": "Kind",
          "type": "string"
        },
        "network_id": {
          "format": "uuid",
          "title": "Network Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "idempotency_key",
        "network_id"
      ],
      "title": "AuditRequest",
      "type": "object"
    },
    "BrownfieldRequest": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "goal": {
          "discriminator": {
            "mapping": {
              "find_static_route": "#/$defs/FindStaticRoute",
              "put_firewall_rule": "#/$defs/PutFirewallRule",
              "put_static_route": "#/$defs/PutStaticRoute",
              "set_routing_protocols": "#/$defs/SetRoutingProtocols"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FindStaticRoute"
            },
            {
              "$ref": "#/$defs/PutStaticRoute"
            },
            {
              "$ref": "#/$defs/PutFirewallRule"
            },
            {
              "$ref": "#/$defs/SetRoutingProtocols"
            }
          ],
          "title": "Goal"
        },
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "const": "brownfield",
          "title": "Kind",
          "type": "string"
        },
        "network_id": {
          "format": "uuid",
          "title": "Network Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "idempotency_key",
        "network_id",
        "goal"
      ],
      "title": "BrownfieldRequest",
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "api_version": {
          "const": "v1",
          "default": "v1",
          "title": "Api Version",
          "type": "string"
        },
        "caller": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Caller",
          "type": "string"
        },
        "external_compatibility": {
          "const": "unverified",
          "default": "unverified",
          "title": "External Compatibility",
          "type": "string"
        },
        "integration": {
          "const": "enabled",
          "default": "enabled",
          "title": "Integration",
          "type": "string"
        },
        "limitations": {
          "default": [
            "polling",
            "local_human_approval",
            "offline_greenfield_sourcing"
          ],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "mode": {
          "const": "mock",
          "default": "mock",
          "title": "Mode",
          "type": "string"
        },
        "network_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Network Id"
        },
        "scenarios": {
          "default": [
            "greenfield",
            "brownfield",
            "audit"
          ],
          "items": {
            "enum": [
              "greenfield",
              "brownfield",
              "audit"
            ],
            "type": "string"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "title": "Scopes",
          "type": "array"
        },
        "workspace_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "caller",
        "network_id",
        "scopes",
        "actions"
      ],
      "title": "Capabilities",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "default": "Static mock configuration. No NAT, asymmetric routing or dataplane verification.",
          "title": "Limitations",
          "type": "string"
        },
        "network_revision": {
          "title": "Network Revision",
          "type": "integer"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Version"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "scope": {
          "format": "uuid",
          "title": "Scope",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "severity",
        "reason",
        "evidence",
        "scope",
        "network_revision",
        "policy_version",
        "timestamp"
      ],
      "title": "Check",
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Events": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/IntegrationEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "events",
        "next_cursor"
      ],
      "title": "Events",
      "type": "object"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "approval_event_id": {
          "format": "uuid",
          "title": "Approval Event Id",
          "type": "string"
        },
        "expected_config_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Config Sha256",
          "type": "string"
        },
        "mock": {
          "const": true,
          "default": true,
          "title": "Mock",
          "type": "boolean"
        },
        "observed_config_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Config Sha256"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "post_check": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Post Check",
          "type": "string"
        },
        "snapshot_revision": {
          "maximum": 9007199254740991.0,
          "minimum": 1.0,
          "title": "Snapshot Revision",
          "type": "integer"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "approval_event_id",
        "snapshot_revision",
        "snapshot_sha256",
        "expected_config_sha256",
        "observed_config_sha256",
        "post_check"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "FindStaticRoute": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "format": "ipvanynetwork",
          "title": "Destination",
          "type": "string"
        },
        "device_id": {
          "format": "uuid",
          "title": "Device Id",
          "type": "string"
        },
        "kind": {
          "const": "find_static_route",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "device_id",
        "destination"
      ],
      "title": "FindStaticRoute",
      "type": "object"
    },
    "FirewallRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Action",
          "type": "string"
        },
        "destination": {
          "format": "ipvanynetwork",
          "title": "Destination",
          "type": "string"
        },
        "destination_port": {
          "anyOf": [
            {
              "maximum": 65535.0,
              "minimum": 1.0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Destination Port"
        },
        "destination_zone": {
          "format": "uuid",
          "title": "Destination Zone",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp",
            "icmp"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "source": {
          "format": "ipvanynetwork",
          "title": "Source",
          "type": "string"
        },
        "source_zone": {
          "format": "uuid",
          "title": "Source Zone",
          "type": "string"
        }
      },
      "required": [
        "source_zone",
        "destination_zone",
        "source",
        "destination",
        "protocol",
        "id",
        "action"
      ],
      "title": "FirewallRule",
      "type": "object"
    },
    "GreenfieldRequest": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "const": "greenfield",
          "title": "Kind",
          "type": "string"
        },
        "requirements": {
          "$ref": "#/$defs/Requirements"
        }
      },
      "required": [
        "kind",
        "idempotency_key",
        "requirements"
      ],
      "title": "GreenfieldRequest",
      "type": "object"
    },
    "IntegrationEvent": {
      "additionalProperties": false,
