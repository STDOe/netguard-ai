      "additionalProperties": false,
      "properties": {
        "address_pool": {
          "anyOf": [
            {
              "format": "ipvanynetwork",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Address Pool"
        },
        "availability": {
          "anyOf": [
            {
              "enum": [
                "single",
                "redundant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Availability"
        },
        "budget_minor": {
          "anyOf": [
            {
              "maximum": 1000000000000.0,
              "minimum": 1.0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Budget Minor"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
