          "title": "Code"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "event": {
          "title": "Event",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "event",
        "code",
        "timestamp",
        "correlation_id",
        "request_id"
      ],
      "title": "IntegrationEvent",
      "type": "object"
    },
    "PlanSummary": {
      "additionalProperties": false,
      "properties": {
        "base_revision": {
          "title": "Base Revision",
          "type": "integer"
        },
        "expected_config_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Config Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "network_id": {
          "format": "uuid",
          "title": "Network Id",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "risk": {
          "enum": [
            "moderate",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
