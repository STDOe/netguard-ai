        "risk",
        "network_id",
        "expires_at",
        "policy_version",
        "base_revision",
        "expected_config_sha256"
      ],
      "title": "PlanSummary",
      "type": "object"
    },
    "PutFirewallRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "put_firewall_rule",
          "title": "Kind",
          "type": "string"
        },
